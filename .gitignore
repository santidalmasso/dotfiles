.DS_Store
.AppleDouble
.LSOverride

*.env
*.log

node_modules
*__pycache__

# App runtime state written into stow-symlinked config dirs.
# ~/.config/{raycast,zed} are symlinks into this repo, so these apps
# write caches, databases and installed bundles here. None of it is config.
home/.config/raycast/*
!home/.config/raycast/scripts/
home/.config/zed/prompts/
home/.config/zed/conversations/

home/.config/herdr/*
!home/.config/herdr/config.toml
!home/.config/herdr/plugins/
# herdr writes install state and GitHub-installed plugins here; track only local plugins.
home/.config/herdr/plugins/*
!home/.config/herdr/plugins/attention-router/

# pi stores auth tokens, sessions, plans and caches alongside its config.
# Track only the five config entries; everything else stays local.
home/.pi/agent/*
!home/.pi/agent/extensions/
!home/.pi/agent/themes/
!home/.pi/agent/mcp.json
!home/.pi/agent/settings.json
!home/.pi/agent/keybindings.json
!home/.pi/agent/AGENTS.md
!home/.pi/agent/agents/

# ~/.claude holds credentials, transcripts and org-specific settings; track only custom agents.
home/.claude/*
!home/.claude/agents/
